{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.mikusnuz/gsc",
  "description": "MCP server for Google Search Console & Indexing API — 13 tools for search analytics, sitemaps, URL inspection, and batch indexing",
  "repository": {
    "url": "https://github.com/mikusnuz/gsc-mcp",
    "source": "github"
  },
  "version": "1.3.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@mikusnuz/gsc-mcp",
      "version": "1.3.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "GSC_CLIENT_ID",
          "description": "Google OAuth2 Client ID",
          "isRequired": false,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "GSC_CLIENT_SECRET",
          "description": "Google OAuth2 Client Secret",
          "isRequired": false,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "GSC_REFRESH_TOKEN",
          "description": "Google OAuth2 Refresh Token",
          "isRequired": false,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "GSC_SERVICE_ACCOUNT_KEY_PATH",
          "description": "Path to Google service account JSON key file",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        }
      ]
    }
  ]
}
